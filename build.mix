  {name: "Max", cpu: 4, ram: 8, disk: 80, price: 419, month: "34.92", blurb: "Bring your sites and mail together in one place.", pick: false,
   fit: "One managed place for every domain, mailbox and site you run, with serious headroom for archives and traffic."}
]

$tech = ["Proxmox VE", "Debian", "Alpine Linux", "NVMe storage", "nginx", "PHP-FPM", "MariaDB", "SQLite", "Postfix", "Dovecot", "Rspamd", "SPF", "DKIM", "DMARC", "PowerDNS", "WireGuard", "nftables", "CrowdSec", "Let&rsquo;s Encrypt", "IPv4 &amp; IPv6", "Git", "CachyOS", "KDE Plasma", "ZFS"]

-- ---------------------------------------------------------------- helpers

fn current($path, $href)
  if $path == $href then
    return " aria-current=\"page\""
  end
  return ""
end

fn nav_html($path)
  $svc_here = ""
  if $path == "/services/" or $path == "/email/" or $path == "/development/" or $path == "/linux/" then
    $svc_here = " class=\"here\""
  end
  $c_home = current($path, "/")
  $c_svc = current($path, "/services/")
  $c_email = current($path, "/email/")
  $c_dev = current($path, "/development/")
  $c_linux = current($path, "/linux/")
  $c_price = current($path, "/pricing/")
  $c_about = current($path, "/about/")
  $h = <<EOF
<ul class="nav" id="nav">
<li><a href="/"${c_home}>Home</a></li>
<li${svc_here}><button class="sub" type="button" aria-haspopup="true">Services ${ico.chev}</button><ul class="drop">
<li><a href="/services/"${c_svc}>All services</a></li>
<li><a href="/pricing/">Managed hosting</a></li>
<li><a href="/email/"${c_email}>Email &amp; domains</a></li>
<li><a href="/development/"${c_dev}>Development</a></li>
<li><a href="/linux/"${c_linux}>Linux support</a></li>
</ul></li>
<li><a href="/pricing/"${c_price}>Pricing</a></li>
<li><a href="/about/"${c_about}>About</a></li>
<li><a class="ext" href="https://my.spiderweb.com.au" target="_blank" rel="noopener">Client portal ${ico.ext}</a></li>
</ul>
EOF
  return $h
end

fn layout($o)
  $nav = nav_html($o.path)
  $canon = $site .. $o.path
  $desc = html_escape($o.desc)
  $extra = $o.head ?? ""
  $h = <<EOF
<!doctype html>
<html lang="en-AU" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${o.title}</title>
<meta name="description" content="${desc}">
<link rel="canonical" href="${canon}">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#0d2030">
<script src="/rn/theme.js?v=${vth}"></script>
<link rel="preload" href="/rn/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/rn/fonts/dmsans.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/rn/site.css?v=${vcss}">
<link rel="icon" href="/favicon.ico">
<meta property="og:site_name" content="RentaNet">
<meta property="og:type" content="website">
<meta property="og:title" content="${o.title}">
<meta property="og:description" content="${desc}">
<meta property="og:url" content="${canon}">
${extra}
<script defer src="/rn/site.js?v=${vjs}"></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"></div>
<header class="site-head">
<div class="wrap">
<a class="logo" href="/" aria-label="RentaNet home">${ico.logo}<span>Renta<b>NET</b></span></a>
<nav aria-label="Main">
${nav}
</nav>
<a class="btn primary small head-cta" href="${mail}">Let&rsquo;s talk ${ico.arrow}</a>
<button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav"><div><span></span><span></span><span></span></div></button>
<button class="icon-btn theme-toggle" type="button" aria-label="Switch colour mode" title="Light / dark mode">
<svg viewBox="0 0 24 24" aria-hidden="true"><mask id="moon"><rect width="24" height="24" fill="#fff"/><circle class="moon-mask" cx="17" cy="7" r="7" fill="#000"/></mask><circle class="sun-core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#moon)"/><g class="sun-rays" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.900 4.900l1.400 1.400M17.700 17.700l1.400 1.400M4.900 19.100l1.400-1.400M17.700 6.300l1.400-1.400"/></g></svg>
</button>
</div>
</header>
<main id="main">
${o.body}
</main>
<footer class="site-foot">
<div class="wrap">
<div class="foot-grid">
<div>
<a class="logo" href="/">${ico.logo}<span>Renta<b>NET</b></span></a>
<p>Independent Australian hosting. Experienced people. Personal service. Since 1998.</p>
</div>
<div>
<h4>Explore</h4>
<ul>
<li><a href="/services/">Our services</a></li>
<li><a href="/pricing/">Hosting plans</a></li>
<li><a href="/email/">Email &amp; domains</a></li>
<li><a href="/development/">Development</a></li>
<li><a href="/linux/">Linux support</a></li>
<li><a href="/about/">About RentaNet</a></li>
</ul>
</div>
<div>
<h4>Customers</h4>
<ul>
<li><a href="https://my.spiderweb.com.au" target="_blank" rel="noopener">Client portal</a></li>
<li><a href="/login">Site sign in</a></li>
<li><a href="https://spiderweb.com.au/privacy-policy/" target="_blank" rel="noopener">Privacy policy</a></li>
<li><a href="https://spiderweb.com.au" target="_blank" rel="noopener">Spiderweb</a></li>
</ul>
</div>
<div>
<h4>Get in touch</h4>
<ul>
<li><a href="${tel}">${phone}</a></li>
<li><a href="${mail}">admin@renta.net</a></li>
<li>10am &ndash; 6pm AEST, 7 days</li>
</ul>
</div>
</div>
<div class="wordmark" aria-hidden="true">RentaNET</div>
<div class="foot-base">
<span>&copy; ${year} RentaNet. Australian owned and operated.</span>
<span><a href="https://www.abr.business.gov.au/SearchByAbn.aspx?SearchText=69851855459" target="_blank" rel="noreferrer noopener">ABN 69 851 855 459</a></span>
</div>
</div>
</footer>
</body>
</html>
EOF
  return $h
end

fn write_page($path, $o)
  $o.path = $path
  $html = layout($o)
  $file = $dist .. $path
  if ends_with($path, "/") then
    $file = $file .. "index.html"
  end
  mkdir(dirname($file))
  write_file($file, $html)
  push($urls, $path)
end

fn page_head($eyebrow, $title, $lead, $more)
  $h = <<EOF
<section class="page-head">
<canvas class="mesh" data-mesh="corner" aria-hidden="true"></canvas>
<div class="wrap">
<div class="eyebrow fade-up d1">${eyebrow}</div>
<h1 class="fade-up d2">${title}</h1>
<p class="lead fade-up d3">${lead}</p>
${more}
</div>
</section>
EOF
  return $h
end

fn head_actions($a_href, $a_label, $b_href, $b_label)
  $h = <<EOF
<div class="hero-cta fade-up d4">
<a class="btn primary" data-magnetic href="${a_href}">${a_label} ${ico.arrow}</a>
<a class="btn" href="${b_href}">${b_label}</a>
</div>
EOF
  return $h
end

fn cta_band()
  $h = <<EOF
<section class="section">
<div class="wrap">
<div class="cta" data-reveal="scale">
<canvas class="mesh" data-mesh="band" data-thread="rgba(170,210,240,.3)" data-net="#7fd0ff" aria-hidden="true"></canvas>
<div>
<span class="eyebrow">Your next step</span>
<h2>Good hosting starts with a real conversation.</h2>
<p>Tell us what you&rsquo;re running and where you want to go. We&rsquo;ll help you choose the right setup.</p>
</div>
<div class="cta-actions">
<a class="btn white big" data-magnetic href="${tel}">${ico.phone} ${phone}</a>
<a class="btn" href="${mail}">${ico.mail} admin@renta.net</a>
<small>10am &ndash; 6pm AEST, 7 days</small>
</div>
</div>
</div>
</section>
EOF
  return $h
end

fn plan_cards()
  $h = ""
  for $p in $plans
    $cls = if $p.pick then "plan featured" else "plan" end
    $tag = if $p.pick then "<span class=\"tagline\">Small business pick</span>" else "" end
    $btn = if $p.pick then "btn primary" else "btn" end
    $n = $p.name
    $card = <<EOF
<article class="${cls}" data-reveal>
${tag}
<h3>${n}</h3>
<p>${p.blurb}</p>
<div class="price">$<span data-count="${p.price}">${p.price}</span><small> / year</small></div>
<div class="monthly">about $${p.month} a month</div>
<ul class="specs">
<li><b>${p.cpu} vCPU</b><span>processor</span><div class="bar"><i class="w${p.cpu}"></i></div></li>
<li><b>${p.ram} GB</b><span>memory</span><div class="bar"><i class="w${p.ram}"></i></div></li>
<li><b>${p.disk} GB</b><span>NVMe storage</span><div class="bar"><i class="w${p.ram}"></i></div></li>
<li><b>Fully managed</b><span>container</span></li>
</ul>
<a class="${btn}" href="mailto:admin@renta.net?subject=${n}%20hosting%20enquiry">Enquire about ${n} ${ico.arrow}</a>
</article>
EOF
    $h = $h .. $card
  end
  return "<div class=\"plans\" data-stagger>" .. $h .. "</div>"
end

fn included()
  return "<div class=\"included\" data-reveal><span>Security updates</span><span>SSL certificates</span><span>Daily backups</span><span>Monitoring</span><span>Email support</span></div>"
end

-- tiles: list of {ico, title, text?, items?}
fn tiles($cls, $list)
  $h = ""
  for $t in $list
    $body = ""
    if has_key($t, "text") then
      $body = "<p>" .. $t.text .. "</p>"
    end
    if has_key($t, "rate") then
      $body = "<div class=\"rate\">" .. $t.rate .. "</div>" .. $body
    end
    if has_key($t, "items") then
      $body = $body .. "<ul>" .. join(map($t.items, fn($i) = "<li>" .. $i .. "</li>"), "") .. "</ul>"
    end
    $h = $h .. "<article class=\"tile\"><div class=\"ico\">" .. $ico[$t.ico] .. "</div><h3>" .. $t.title .. "</h3>" .. $body .. "</article>"
  end
  return "<div class=\"" .. $cls .. "\" data-stagger>" .. $h .. "</div>"
end

-- ticks: list of [bold, detail]
fn ticks($cls, $list)
  $h = join(map($list, fn($t) = "<li><div><b>" .. $t[0] .. "</b><span>" .. $t[1] .. "</span></div></li>"), "")
  return "<ul class=\"" .. $cls .. "\" data-stagger>" .. $h .. "</ul>"
end

-- faqs: list of [question, answer]
fn faqs($list)
  $h = join(map($list, fn($f) = "<details class=\"faq\"><summary>" .. $f[0] .. "</summary><p>" .. $f[1] .. "</p></details>"), "")
  return "<div class=\"faqs\" data-stagger>" .. $h .. "</div>"
end

fn lede($eyebrow, $title, $text)
  return "<div class=\"lede\" data-reveal><span class=\"eyebrow\">" .. $eyebrow .. "</span><h2>" .. $title .. "</h2><p>" .. $text .. "</p></div>"
end

$cta = cta_band()
$strip = join(map($tech, fn($t) = "<span>" .. $t .. "</span>"), "")
$marquee = "<div class=\"marquee\" aria-hidden=\"true\"><div>" .. $strip .. $strip .. "</div></div>"

$faq_pricing = [
  ["What&rsquo;s included in management?", "OS updates, security patches, SSL certificate renewals, monitoring, daily backups and email support. Contact us about application work, migrations or hands-on support outside routine management."],
  ["How does extra capacity work?", "Plans use a $19/year base plus $20/year per resource unit. A unit is 1 vCPU, 1 GB RAM or 10 GB NVMe storage. The four plans are convenient preset shapes: Lite is 3 units, Standard is 6, Plus is 11 and Max is 20. Ask us about bulk storage and dedicated IPv4 requirements."],
  ["Can I grow a plan later?", "Yes. Capacity is added one unit at a time, so a plan can grow with you without moving to a different product. Tell us what you need and we&rsquo;ll confirm the new annual price before changing anything."],
  ["Can you manage an existing server?", "Yes. Managed Debian virtual machines and management of an existing BinaryLane, Vultr or DigitalOcean VPS are available by arrangement. We&rsquo;ll quote for your workload."],
  ["How do I order or move an existing site?", "Email admin@renta.net or call 0419 530 037. We&rsquo;ll confirm the right plan, review compatibility and agree on any migration work before making changes."],
  ["What do hands-on support and development cost?", "Hands-on support and Linux consulting are $60/hour. AI-assisted application development is $120/hour. We agree on scope and costs before starting."]
]

-- ---------------------------------------------------------------- home

$plan_html = plan_cards()
$inc = included()
$home_services = <<EOF
<div class="cards" data-stagger>
<article class="card"><span class="num">01 / Hosting</span><div class="ico">${ico.server}</div><h3>Your business. A dependable home.</h3><p>Managed Linux containers with fast NVMe storage, web hosting, email and DNS. We take care of the server so you can get on with your work.</p><span class="go">Explore hosting plans ${ico.arrow}</span><a class="cover" href="/pricing/" aria-label="Hosting plans"></a></article>
<article class="card"><span class="num">02 / Email &amp; domains</span><div class="ico">${ico.mail}</div><h3>Make the right connection.</h3><p>Business email, domain registration, DNS and mail migration, with help on SPF, DKIM, DMARC and spam filtering.</p><span class="go">Email and domains ${ico.arrow}</span><a class="cover" href="/email/" aria-label="Email and domains"></a></article>
<article class="card"><span class="num">03 / Development</span><div class="ico">${ico.code}</div><h3>Turn your next idea into something useful.</h3><p>Websites, applications and automation built with AI-assisted development, expert oversight and full ownership of your code.</p><span class="go">See what we can build ${ico.arrow}</span><a class="cover" href="/development/" aria-label="Development"></a></article>
<article class="card"><span class="num">04 / Linux support</span><div class="ico">${ico.terminal}</div><h3>Experience when you need it.</h3><p>From a stubborn email problem to a Proxmox migration. Practical help with Linux servers, security, networking and desktops.</p><span class="go">Meet your support options ${ico.arrow}</span><a class="cover" href="/linux/" aria-label="Linux support"></a></article>
</div>
EOF
$home_stack = tiles("grid4", [
  {ico: "globe", title: "Web", text: "Your site and applications, served over HTTPS with certificates renewed for you."},
  {ico: "mail", title: "Mail", text: "Business email at your own domain, with SPF, DKIM and DMARC set up properly."},
  {ico: "network", title: "DNS", text: "Your domain services looked after in the same place as your site and mail."},
  {ico: "shield", title: "Care", text: "Security updates, daily backups and monitoring, handled as routine."}
])
$home_faq = faqs(take($faq_pricing, 3))
$ld = "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"RentaNet\",\"url\":\"https://renta.net/\",\"foundingDate\":\"1998\",\"telephone\":\"+61419530037\",\"email\":\"admin@renta.net\",\"areaServed\":\"AU\",\"description\":\"Managed Linux hosting, business email, Linux support and AI-assisted development. Australian owned since 1998.\"}</script>"

$body = <<EOF
<section class="hero">
<canvas class="mesh" data-mesh="hero" aria-hidden="true"></canvas>
<div class="grain" aria-hidden="true"></div>
<div class="wrap hero-grid">
