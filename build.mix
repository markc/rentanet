  lock: svg("<rect x=\"5\" y=\"10.500\" width=\"14\" height=\"9.500\" rx=\"2\" pathLength=\"100\"/><path d=\"M8 10.500V8a4 4 0 0 1 8 0v2.500\" pathLength=\"100\"/>"),
  wallet: svg("<path d=\"M4 7.500A2.500 2.500 0 0 1 6.500 5H18v3\" pathLength=\"100\"/><rect x=\"4\" y=\"8\" width=\"16\" height=\"11\" rx=\"2\" pathLength=\"100\"/><path d=\"M16 13.500h.01\" pathLength=\"100\"/>"),
  eye: svg("<path d=\"M2.500 12s3.500-6.500 9.500-6.500 9.500 6.500 9.500 6.500-3.500 6.500-9.500 6.500S2.500 12 2.500 12z\" pathLength=\"100\"/><circle cx=\"12\" cy=\"12\" r=\"2.700\" pathLength=\"100\"/>"),
