#!/opt/mix/bin/mix
-- version: 2.0.0
-- Static site generator for renta.net.
--   mix build.mix          writes ./dist
-- Page copy lives in this file; assets/ holds css, js and fonts (published
-- under /rn/, because webd serves its own shared files at /assets/); static/ is
-- copied to the web root as is. No inline scripts or styles are emitted, so
-- the pages work under a strict Content-Security-Policy.

$root = dirname(realpath(script_path()))
$dist = $root .. "/dist"
$site = "https://renta.net"
$phone = "0419 530 037"
$tel = "tel:+61419530037"
$mail = "mailto:admin@renta.net"
$year = date_format(time(), "%Y")
$today = date_format(time(), "%Y-%m-%d")

remove_dir($dist)
copy_tree($root .. "/static", $dist)
copy_tree($root .. "/assets", $dist .. "/rn")
$vcss = left(hash_file($root .. "/assets/site.css"), 10)
$vjs = left(hash_file($root .. "/assets/site.js"), 10)
$vth = left(hash_file($root .. "/assets/theme.js"), 10)
$urls = []

-- ---------------------------------------------------------------- icons

fn svg($paths)
  return "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">" .. $paths .. "</svg>"
end

$ico = {
  server: svg("<rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\" pathLength=\"100\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\" pathLength=\"100\"/><path d=\"M7 7.5h.01M7 16.5h.01M11 7.500h6M11 16.500h6\" pathLength=\"100\"/>"),
  mail: svg("<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2.5\" pathLength=\"100\"/><path d=\"M3.5 7.5l8.5 6 8.5-6\" pathLength=\"100\"/>"),
  code: svg("<path d=\"M8.5 7l-5 5 5 5\" pathLength=\"100\"/><path d=\"M15.5 7l5 5-5 5\" pathLength=\"100\"/><path d=\"M13.500 4.500l-3 15\" pathLength=\"100\"/>"),
  terminal: svg("<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2.5\" pathLength=\"100\"/><path d=\"M7.5 9.5l3 2.500-3 2.500\" pathLength=\"100\"/><path d=\"M12.500 15h4\" pathLength=\"100\"/>"),
