-- ---------------------------------------------------------------- linux

$head = page_head("Linux support", "When the problem is technical, the support should be personal.",
  "28+ years of Linux experience. Practical help with servers, mail, security, networking and desktops, from $60/hour.",
  head_actions($tel, "Call " .. $phone, $mail .. "?subject=Linux%20support", "Email for support"))
$x1 = tiles("grid4", [
  {ico: "server", title: "Keep your systems moving.", text: "Debian, Ubuntu, Alpine and Rocky Linux administration. Provisioning, troubleshooting, security hardening, certificates, backups and monitoring."},
  {ico: "cluster", title: "Make infrastructure work for you.", text: "Proxmox cluster management, virtual machines and containers, migrations and high availability planning. Existing cluster management is available by arrangement."},
  {ico: "network", title: "Get connected. Stay connected.", text: "Mail server troubleshooting, delivery and authentication, DNS, PowerDNS, WireGuard VPNs, IPv4 and IPv6. Clear advice grounded in your actual setup."},
  {ico: "desktop", title: "A fresh start for your desktop.", text: "CachyOS installation and ongoing support, including KDE Plasma, getting familiar with Linux and making better use of existing hardware."}
])
$x2 = tiles("grid4", [
  {ico: "globe", title: "Web", items: ["nginx", "PHP-FPM", "Let&rsquo;s Encrypt", "HTTP/2"]},
  {ico: "database", title: "Data", items: ["MariaDB and MySQL", "PostgreSQL", "SQLite", "Redis"]},
  {ico: "mail", title: "Mail", items: ["Postfix and Dovecot", "Rspamd", "SPF, DKIM, DMARC", "Mail migration"]},
  {ico: "network", title: "Network", items: ["PowerDNS", "WireGuard VPN", "IPv4 and IPv6", "nftables and CrowdSec"]}
])
$x3 = tiles("grid4", [
  {ico: "wallet", title: "Cost-effective", items: ["Free to download and use", "No licensing fees", "Runs on older hardware"]},
  {ico: "code", title: "Open source", items: ["Full transparency", "Community-driven", "Endless customisation"]},
  {ico: "shield", title: "Security &amp; privacy", items: ["Built-in protections", "Less malware targets it", "No user tracking"]},
  {ico: "bolt", title: "Performance", items: ["Efficient use of resources", "Optimised kernels", "No bloatware"]}
])
$x4 = tiles("grid3", [
  {ico: "chat", title: "Quick questions", rate: "Free", text: "A simple question by phone or email. Ask before you spend an afternoon on it."},
  {ico: "wrench", title: "Hands-on support", rate: "$60<small> / hour</small>", text: "Remote assistance over SSH or a call. Server administration, troubleshooting and Linux consulting."},
  {ico: "code", title: "AI-assisted development", rate: "$120<small> / hour</small>", text: "Scripts, automation and applications when the fix is something that needs building."}
])
$lx1 = lede("What we work on", "Practical help, grounded in your actual setup.", "Servers, clusters, networks and desktops. If it runs Linux, there is a good chance we have fixed one like it.")
$lx2 = lede("Technologies", "Open source tools we work with every day.", "")
$lx3 = lede("Linux on the desktop", "CachyOS with KDE Plasma.", "Ready to break free from Windows? This is the desktop we recommend and support.")
$lx4 = lede("Make the switch", "Why use a Linux desktop?", "Freedom, privacy and performance.")
$lx5 = lede("Step by step", "How to install CachyOS.", "A simple guide to replacing Windows with CachyOS. Allow 30 to 60 minutes and have a USB stick of 8 GB or larger.")
$lx6 = lede("Support options", "Help that fits the job.", "From a quick question to full remote assistance. We agree on scope and costs before starting.")
$xfaq = faqs([
  ["What does support cost?", "Hands-on support and Linux consulting are $60/hour. AI-assisted application development is $120/hour. We&rsquo;ll agree on scope and costs before starting."],
  ["Can you help remotely?", "Yes. We work over SSH or a remote call as appropriate. Contact us first to describe the issue and arrange access."],
  ["When can I contact you?", "10am to 6pm AEST, seven days. Call 0419 530 037 or email admin@renta.net."],
  ["Can you take over a server someone else set up?", "Yes. Managed Debian virtual machines and management of an existing VPS or Proxmox cluster are available by arrangement. We start by looking at what is there and tell you what we find."]
])
$body = <<EOF
${head}
<section class="section tight">
<div class="wrap">
${lx1}
${x1}
</div>
</section>
${marquee}
<section class="section">
<div class="wrap">
${lx2}
${x2}
</div>
</section>
<section class="section alt" id="cachyos">
<div class="wrap">
${lx3}
<div class="longform" data-stagger>
<div><h3>About CachyOS</h3><p><a class="more" href="https://cachyos.org" target="_blank" rel="noopener nofollow">CachyOS</a> is a lightweight, Arch Linux-based distribution that emphasises performance, security and user-friendliness. Built with optimised kernels and modern tooling, it stays fully compatible with the Arch User Repository, which gives you access to thousands of community-maintained packages.</p></div>
<div><h3>Why make the switch?</h3><p>Windows 11&rsquo;s hardware requirements have left a great many perfectly good computers behind. CachyOS runs well on older hardware, respects your privacy and puts you in control of your own computer. No telemetry, no mandatory cloud accounts and no subscriptions.</p></div>
<div><h3>KDE Plasma: the modern desktop</h3><p>We recommend the <a class="more" href="https://kde.org/plasma-desktop" target="_blank" rel="noopener nofollow">KDE Plasma</a> edition. It offers a familiar Windows-like experience with a taskbar, start menu and system tray, but with far greater customisation. Virtual desktops, floating panels and automatic light-to-dark theme switching make it a pleasure to use every day.</p></div>
<div><h3>ZFS, straight from the installer</h3><p>CachyOS is one of the few distributions that offers ZFS from the graphical installer. ZFS brings instant snapshots, transparent compression and self-healing storage, so you can roll your whole system back to an earlier snapshot if an update goes wrong.</p></div>
<div><h3>It&rsquo;s easier than you think</h3><p>The installer is friendly, and the system comes with what you need: Firefox for browsing, LibreOffice for documents and thousands of free applications a click away. Your files transfer across and the learning curve is small.</p></div>
<div><h3>We&rsquo;re here to help</h3><p>We provide full support for CachyOS with KDE Plasma, from the first installation to ongoing maintenance: migrating from Windows, setting up ZFS snapshots, configuring particular software, or simply some guidance while you find your way around.</p></div>
</div>
</div>
</section>
<section class="section">
<div class="wrap">
${lx4}
${x3}
</div>
</section>
<section class="section alt" id="install">
<div class="wrap">
${lx5}
<div class="callout" data-reveal><b>Back up first</b><p>Copy your photos, documents and anything else you want to keep to an external drive or cloud storage. Installing CachyOS this way erases Windows and everything on the disk.</p></div>
<ol class="guide" data-stagger>
<li><div><h3>Download CachyOS</h3><ul><li>Go to cachyos.org and choose Download</li><li>Pick the KDE Plasma edition, the most Windows-like</li><li>Save the .iso file somewhere easy to find</li></ul></div></li>
<li><div><h3>Create a bootable USB</h3><ul><li>Download a free tool such as Rufus on Windows or balenaEtcher on a Mac</li><li>Plug in your USB stick and open the tool</li><li>Select the CachyOS .iso and start writing</li><li>Wait a few minutes for it to finish</li></ul></div></li>
<li><div><h3>Boot from the USB</h3><ul><li>Restart your computer with the USB plugged in</li><li>As it starts, tap F12, F2 or Del to reach the boot menu (it depends on your computer)</li><li>Select your USB stick from the list</li><li>CachyOS loads in a minute or two</li></ul></div></li>
<li><div><h3>Install CachyOS</h3><ul><li>Choose Install CachyOS, then your language, location and keyboard</li><li>When asked about the disk, select Erase disk, the simple option</li><li>Create your username and password</li><li>Wait 10 to 20 minutes, then restart and remove the USB when prompted</li></ul></div></li>
<li><div><h3>First boot</h3><ul><li>Log in with the password you created</li><li>The bottom-left corner is your start menu</li><li>Dolphin is the file manager, like File Explorer</li><li>Firefox is your browser, and the software centre installs new apps</li></ul><p>Need help with the installation? Call ${phone}.</p></div></li>
</ol>
</div>
</section>
<section class="section">
<div class="wrap">
${lx6}
${x4}
</div>
</section>
<section class="section alt">
<div class="wrap">
<div class="lede" data-reveal><span class="eyebrow">Questions</span><h2>Good to know.</h2></div>
${xfaq}
</div>
</section>
${cta}
EOF
write_page("/linux/", {title: "Linux Support | RentaNet",
  desc: "28+ years of Linux experience. Server administration, Proxmox, mail, networking and CachyOS desktop support from $60/hour, with a step-by-step CachyOS install guide.",
  body: $body})

