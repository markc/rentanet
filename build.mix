  $smap = $smap .. "<url><loc>" .. $site .. $u .. "</loc><lastmod>" .. $today .. "</lastmod></url>\n"
end
write_file($dist .. "/sitemap.xml", "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n" .. $smap .. "</urlset>\n")

print "built", len($urls), "pages into", $dist
