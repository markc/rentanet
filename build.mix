  chev: "<svg viewBox=\"0 0 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M2 4l4 4 4-4\"/></svg>",
  tick: "<svg viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"8\"/><path d=\"M6.300 10.300l2.500 2.500 4.900-5.100\"/></svg>",
  logo: "<svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><rect width=\"32\" height=\"32\" rx=\"8\" fill=\"#0d2030\"/><rect x=\".5\" y=\".5\" width=\"31\" height=\"31\" rx=\"7.500\" fill=\"none\" stroke=\"#57c1ff\" stroke-opacity=\".45\"/><path d=\"M9 10.500L23 10.500M9 10.500L16 22M23 10.500L16 22\" stroke=\"#57c1ff\" stroke-width=\"1.400\" fill=\"none\"/><circle class=\"n\" cx=\"9\" cy=\"10.500\" r=\"3\" fill=\"#fff\"/><circle class=\"n n2\" cx=\"23\" cy=\"10.500\" r=\"3\" fill=\"#fff\"/><circle class=\"n n3\" cx=\"16\" cy=\"22\" r=\"3.400\" fill=\"#ff5263\"/></svg>"
}

-- ---------------------------------------------------------------- data

$plans = [
  {name: "Lite", cpu: 1, ram: 1, disk: 10, price: 79, month: "6.58", blurb: "A focused home for your first site and email.", pick: false,
   fit: "A complete online presence for one domain: your website, real mailboxes at your own address and DNS. A good fit for a personal domain or a side project."},
  {name: "Standard", cpu: 2, ram: 2, disk: 20, price: 139, month: "11.58", blurb: "Room for a small business to make its next move.", pick: true,
