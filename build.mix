  database: svg("<ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\" pathLength=\"100\"/><path d=\"M4 6v6c0 1.700 3.600 3 8 3s8-1.300 8-3V6\" pathLength=\"100\"/><path d=\"M4 12v6c0 1.700 3.600 3 8 3s8-1.300 8-3v-6\" pathLength=\"100\"/>"),
  cluster: svg("<rect x=\"9\" y=\"3\" width=\"6\" height=\"5\" rx=\"1.200\" pathLength=\"100\"/><rect x=\"3\" y=\"16\" width=\"6\" height=\"5\" rx=\"1.200\" pathLength=\"100\"/><rect x=\"15\" y=\"16\" width=\"6\" height=\"5\" rx=\"1.200\" pathLength=\"100\"/><path d=\"M12 8v4M6 16v-2.500h12V16\" pathLength=\"100\"/>"),
